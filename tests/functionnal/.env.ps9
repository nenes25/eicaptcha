# PrestaShop 9.x Test Environment Configuration

# PrestaShop Version
PS_VERSION=9.0.0

# Database Configuration
MYSQL_ROOT_PASSWORD=prestashop
MYSQL_DATABASE=prestashop
MYSQL_USER=prestashop
MYSQL_PASSWORD=prestashop

# PrestaShop Admin Configuration
ADMIN_MAIL=admin@prestashop.local
ADMIN_PASSWD=Prestashop123

# Test Environment URL (for Playwright tests)
# Use http://localhost:8080 when running tests from host machine
# Use http://prestashop:80 when running tests inside Docker
CI_ENVIRONMENT_URL=http://localhost:8080

# Snapshot to restore
SNAPSHOT_FILE=prestashop-9.x-snapshot.sql
